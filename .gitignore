*.tfvars
*.tfvars.json
!example.tfvars
!example.tfvars.json

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI config
.terraformrc
terraform.rc

# Env files
.env
.env.*

node_modules/
dist/
build/

